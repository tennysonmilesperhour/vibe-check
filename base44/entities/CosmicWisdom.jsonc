{
  "name": "CosmicWisdom",
  "type": "object",
  "properties": {
    "period_type": {
      "type": "string",
      "enum": [
        "daily",
        "weekly",
        "monthly",
        "yearly"
      ],
      "description": "The cadence of this wisdom entry"
    },
    "period_key": {
      "type": "string",
      "description": "Unique key for this period, e.g. 2026-04-09 or 2026-W15 or 2026-04 or 2026"
    },
    "systems_key": {
      "type": "string",
      "description": "Sorted comma-separated list of enabled systems when generated, for cache-busting"
    },
    "wisdom": {
      "type": "string",
      "description": "The generated wisdom text"
    },
    "theme": {
      "type": "string",
      "description": "Short evocative theme/title for this period"
    },
    "contemplation": {
      "type": "string",
      "description": "A contemplation question or practice for the period"
    },
    "is_read": {
      "type": "boolean",
      "default": false,
      "description": "Whether the user has opened/read this wisdom"
    }
  },
  "required": [
    "period_type",
    "period_key",
    "wisdom"
  ]
}