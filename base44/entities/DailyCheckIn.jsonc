{
  "name": "DailyCheckIn",
  "type": "object",
  "properties": {
    "date": {
      "type": "string",
      "format": "date",
      "description": "Date of the check-in"
    },
    "mood_score": {
      "type": "number",
      "minimum": 1,
      "maximum": 10,
      "description": "Overall mood score from 1-10"
    },
    "energy_level": {
      "type": "number",
      "minimum": 1,
      "maximum": 10,
      "description": "Energy level from 1-10"
    },
    "sleep_quality": {
      "type": "number",
      "minimum": 1,
      "maximum": 10,
      "description": "Sleep quality from 1-10"
    },
    "emotions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Selected emotion tags"
    },
    "activities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Activities done today"
    },
    "high_moment": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string"
        },
        "who_involved": {
          "type": "string"
        },
        "context": {
          "type": "string"
        },
        "intensity": {
          "type": "number",
          "minimum": 1,
          "maximum": 10
        }
      }
    },
    "low_moment": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string"
        },
        "who_involved": {
          "type": "string"
        },
        "context": {
          "type": "string"
        },
        "intensity": {
          "type": "number",
          "minimum": 1,
          "maximum": 10
        }
      }
    },
    "gratitude": {
      "type": "string",
      "description": "Something you're grateful for today"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes or reflections"
    },
    "moon_phase": {
      "type": "string",
      "description": "Computed lunar phase name at check-in time, stamped by the resonance engine"
    },
    "personal_day": {
      "type": "number",
      "description": "Numerology personal day number (1-9), stamped by the resonance engine"
    },
    "person_ids": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Person entity ids involved in today's moments (replaces free-text who_involved)"
    }
  },
  "required": [
    "date",
    "mood_score"
  ]
}