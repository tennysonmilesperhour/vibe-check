{
  "name": "Person",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Display name of this person"
    },
    "person_type": {
      "type": "string",
      "enum": ["family", "friend", "partner", "colleague", "community", "other"],
      "description": "Nature of the relationship"
    },
    "linked_user_email": {
      "type": "string",
      "description": "Email of the linked vibe-check user, when this person is also on the app"
    },
    "cosmic_snapshot": {
      "type": "object",
      "description": "Cached cosmic profile of the linked user, refreshed when their profile is newer",
      "additionalProperties": true
    },
    "snapshot_updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "When cosmic_snapshot was last refreshed"
    },
    "qualities": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Qualities the user appreciates in this person"
    },
    "concerns": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Concerns or friction points"
    },
    "boundary_notes": {
      "type": "string",
      "description": "Personal boundary notes about this relationship"
    },
    "synergy_reading": {
      "type": "string",
      "description": "Persisted AI synergy reading between the user and this person"
    },
    "synergy_generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the synergy reading was generated"
    },
    "legacy_names": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Old free-text aliases from the who_involved era, used for historical matching"
    }
  },
  "required": ["name"]
}
