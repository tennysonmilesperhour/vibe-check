{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/Today", "destination": "/index.html" },
    { "source": "/Analytics", "destination": "/index.html" },
    { "source": "/People", "destination": "/index.html" },
    { "source": "/Practice", "destination": "/index.html" },
    { "source": "/CosmicAddons", "destination": "/index.html" },
    { "source": "/privacy", "destination": "/index.html" },
    { "source": "/terms", "destination": "/index.html" },
    { "source": "/support", "destination": "/index.html" },
    { "source": "/Dashboard", "destination": "/index.html" },
    { "source": "/DailyLog", "destination": "/index.html" },
    { "source": "/Boundaries", "destination": "/index.html" },
    { "source": "/Relationships", "destination": "/index.html" },
    { "source": "/Constellation", "destination": "/index.html" },
    { "source": "/TarotReading", "destination": "/index.html" },
    { "source": "/HealingBoard", "destination": "/index.html" },
    { "source": "/CosmicWisdom", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self' https://*.supabase.co wss://*.supabase.co; worker-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" }
      ]
    }
  ]
}
